# Copy to .env for local development with `netlify dev`. Never commit .env.

# Airtable Personal Access Token (starts with "pat…").
# Scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=pat_your_token_here

# The "JV Expenses" base id.
AIRTABLE_BASE_ID=appquqkhFfrnoU6v9

# Google OAuth Client ID (ends in .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Only sign-ins from this Google Workspace domain are allowed.
ALLOWED_DOMAIN=josiahventure.com

# Optional: extra individual Google emails allowed in besides the domain above
# (e.g. an outside tester). Comma-separated. Leave unset for domain-only.
# ALLOWED_EMAILS=someone@gmail.com, tester@example.com

# Optional: enables the "read my receipt" auto-fill. Anthropic (Claude) API key.
# Leave unset to turn the scanner off — the app still works, people just type
# the fields in. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: model used to read receipts. Defaults to claude-opus-4-8 (most
# accurate). Set to claude-haiku-4-5 for faster, cheaper scans.
# SCAN_MODEL=claude-opus-4-8

# Optional: email notifications (submit → approve → reimburse). Leave unset to
# keep them off. Get a key at https://resend.com and verify your domain.
# RESEND_API_KEY=re_your_key_here
# NOTIFY_FROM=Rembly <rembly@josiahventure.com>
# APP_URL=https://reimbly.netlify.app

# Optional: iPhone / browser push notifications. Leave unset to keep push off.
# Generate a key pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your_public_key_here
# VAPID_PRIVATE_KEY=your_private_key_here
# VAPID_SUBJECT=mailto:it@josiahventure.com
