# Copy to .env for local development with `netlify dev`. Never commit .env.

# Airtable Personal Access Token (starts with "pat…").
# Scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=pat_your_token_here

# The "JV Expenses" base id.
AIRTABLE_BASE_ID=appquqkhFfrnoU6v9

# Google OAuth Client ID (ends in .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Only sign-ins from this Google Workspace domain are allowed.
ALLOWED_DOMAIN=josiahventure.com
